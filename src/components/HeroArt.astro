---
import Bot from './Bot.astro';
---
<div class="hero-art" aria-label="A little world of code, with a friendly robot and colorful command blocks" role="img">
 <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
 <span class="art-star star-one">✦</span><span class="art-star star-two">✷</span><span class="art-star star-three">+</span>
 <div class="art-note">BIG ideas start small.</div>
 <div class="code-window"><div class="window-bar"><i></i><i></i><i></i><span>my_first_adventure.py</span></div><div class="art-code"><span class="pink">dream</span> = <span class="yellow">"something awesome"</span><br/><span class="mint">while</span> curious:<br/>&nbsp;&nbsp;try_something()<br/>&nbsp;&nbsp;<span class="yellow">keep_going()</span><br/><br/><span class="comment"># You've got this!</span></div></div>
 <div class="hero-bot"><Bot size={218}/><span>Hi, I’m Bit!</span></div>
 <div class="command-sticker"><span>↻</span> repeat the fun <b>3×</b></div>
 <div class="pixel-sticker" aria-hidden="true"><div>🕹</div><span>PLAYER ONE: YOU</span></div>
 <div class="made-sticker">✧<br/>made<br/><b>by you.</b></div>
</div>
