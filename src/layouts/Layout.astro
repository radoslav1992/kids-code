---
import '../styles/global.css';
const brand='KidsCode';
const {title='KidsCode: Free Coding for Kids – Block Coding & Python', description='KidsCode is a free coding website for kids: robot coding games, 20 block coding missions, 10 Python lessons, and an online Python playground. No sign-up.', breadcrumbs=[], schema=[], noindex=false}=Astro.props;
const path=Astro.url.pathname;
const nav=[['/explore/','Explore'],['/blocks/','Learn with blocks'],['/python/','Learn Python'],['/projects/','Make stuff']];
const canonical=Astro.site ? new URL(path,Astro.site).href : undefined;
const pageTitle=title.includes(brand)?title:`${title} | ${brand}`;
// Structured data: the site identity on the home page, a breadcrumb trail on nested pages, plus any page-specific items.
const home=new URL('/',Astro.site).href;
const org={'@type':'Organization','@id':home+'#organization',name:brand,alternateName:'Kids Code',url:home,email:'info@kidscode.dev',logo:new URL('/favicon.svg',Astro.site).href};
const graph=[...(path==='/'?[{'@context':'https://schema.org','@type':'WebSite','@id':home+'#website',name:brand,alternateName:['Kids Code','kidscode.dev'],url:home,description,inLanguage:'en',publisher:{'@id':org['@id']}},{'@context':'https://schema.org',...org}]:[]),...(breadcrumbs.length?[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[['Home','/'],...breadcrumbs].map(([name,href],i)=>({'@type':'ListItem',position:i+1,name,item:new URL(href,Astro.site).href}))}]:[]),...[schema].flat()];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#faf8ee"/><title>{pageTitle}</title><meta name="description" content={description}/>{noindex?<meta name="robots" content="noindex,follow"/>:canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:site_name" content={brand}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:locale" content="en_US"/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/>{graph.map(item=><script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g,'\\u003c')}/>)}<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-S48T3RS4FW"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-S48T3RS4FW');
</script>
</head><body><a class="skip" href="#main">Skip to the fun</a><header class="site-header"><a class="logo" href="/" aria-label="KidsCode home"><img src="/favicon.svg" width="38" height="38" alt=""/>kids<span>code</span><span class="logo-dot">✦</span></a><nav aria-label="Main navigation">{nav.map(([href,label])=><a href={href} aria-current={path.startsWith(href)?'page':undefined}>{label}</a>)}</nav><a class="button small dark header-cta" href="/playground/">Python playground <span>↗</span></a></header><main id="main"><slot/></main><footer><div><a class="logo" href="/"><img src="/favicon.svg" width="32" height="32" alt=""/>kids<span>code</span></a><p>Small steps. Big “I made that!” energy.</p></div><div class="footer-links"><a href="/glossary/">Coding words</a><a href="/grownups/">For grown-ups</a><a href="/one-hour-coding/">One-hour coding plan</a><a href="/#learning-apps">Explore our learning apps</a><a href="mailto:info@kidscode.dev">info@kidscode.dev</a><a href="/explore/#my-progress">My discoveries</a><a href="/playground/">Python playground</a></div><div class="footer-bottom">Made for curious minds. No accounts. No ads. Just possibilities.<span>Take a stretch. Then make something.</span></div></footer><script>import '../scripts/shared';</script></body></html>
