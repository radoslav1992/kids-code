---
import '../styles/global.css';
const {title='Kids Code — Learn to code through play', description='Free interactive coding adventures for kids. Learn programming with robot puzzles, pixel art, short Python lessons, and an online Python playground.'}=Astro.props;
const path=Astro.url.pathname;
const nav=[['/explore/','Explore'],['/blocks/','Learn with blocks'],['/python/','Learn Python'],['/projects/','Make stuff']];
const canonical=Astro.site ? new URL(path,Astro.site).href : undefined;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#faf8ee"/><title>{title}</title><meta name="description" content={description}/>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical&&<meta property="og:url" content={canonical}/>}<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-S48T3RS4FW"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-S48T3RS4FW');
</script>
</head><body><a class="skip" href="#main">Skip to the fun</a><header class="site-header"><a class="logo" href="/" aria-label="Kids Code home"><img src="/favicon.svg" width="38" height="38" alt=""/>kids<span>code</span><span class="logo-dot">✦</span></a><nav aria-label="Main navigation">{nav.map(([href,label])=><a href={href} aria-current={path.startsWith(href)?'page':undefined}>{label}</a>)}</nav><a class="button small dark header-cta" href="/playground/">Python playground <span>↗</span></a></header><main id="main"><slot/></main><footer><div><a class="logo" href="/"><img src="/favicon.svg" width="32" height="32" alt=""/>kids<span>code</span></a><p>Small steps. Big “I made that!” energy.</p></div><div class="footer-links"><a href="/glossary/">Coding words</a><a href="/grownups/">For grown-ups</a><a href="/explore/#my-progress">My discoveries</a><a href="/playground/">Python playground</a></div><div class="footer-bottom">Made for curious minds. No accounts. No ads. Just possibilities.<span>Take a stretch. Then make something.</span></div></footer><script>import '../scripts/shared';</script></body></html>
