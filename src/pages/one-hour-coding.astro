---
import Layout from '../layouts/Layout.astro';import Faq from '../components/Faq.astro';import {lessons} from '../lib/lessons.mjs';import {blockLessons} from '../lib/blocks/curriculum.mjs';
const block=slug=>blockLessons.find(l=>l.slug===slug),python=slug=>lessons.find(l=>l.slug===slug);
const lessonStep=(l,href,label)=>({time:l.time,title:`${label} ${l.topic}`,href,text:l.title});
const warmup={time:5,title:'Warm-up: be the robot',text:'One partner is the robot and follows instructions exactly: step forward, turn left, turn right. The other guides them to a target. Swap. What happened when a step was missing?'};
const routes=[
{name:'First clicks',who:'No typing · roughly ages 7–10',tint:'green',intro:'Robot puzzles and pixel art build sequencing, loops, and debugging without a keyboard.',steps:[warmup,{time:15,title:'Robot missions 1–4',href:'/adventures/',text:'Plan arrow commands, then use Repeat to do more with fewer steps.'},{time:15,title:'Robot missions 5–8',href:'/adventures/',text:'Break big routes into little steps and fix plans that bump into walls.'},{time:15,title:'Pixel studio',href:'/studio/',text:'Turn on Mirror and paint a symmetrical robot or creature using coordinates.'},{time:10,title:'Share & reflect',text:'Show a partner your art. Which bug was the trickiest to fix?'}]},
{name:'Block builders',who:'Comfortable readers',tint:'blue',intro:'Snap together real programs with variables, decisions, and loops, then test them.',steps:[{time:5,title:'Warm-up: robot missions 1–2',href:'/adventures/',text:'A quick reminder that computers follow instructions in order.'},...['sequences','variables','if-else','repeat-loops'].map(slug=>lessonStep(block(slug),'/blocks/'+slug+'/',`Block mission ${block(slug).index+1}:`)),{time:10,title:'Bug detective quiz',href:'/debug-detective/',text:'Predict what code does and spot the mistake in eight short puzzles.'},{time:10,title:'Free block playground',href:'/blocks/playground/',text:'Build a mood machine: if the mood is happy, Bit says something cheerful.'},{time:8,title:'Share & reflect',text:'Run your partner’s program. Can you predict what it will do first?'}]},
{name:'First Python',who:'Confident readers & typists · often 10+',tint:'yellow',intro:'Type real Python, run it in the browser, and finish with a project to remix.',steps:[warmup,...['hello-world','variables','conditionals','loops'].map(slug=>lessonStep(python(slug),'/python/'+slug+'/',`Python lesson ${lessons.indexOf(python(slug))+1}:`)),{time:17,title:'Project: silly story machine',href:'/playground/?project=story',text:'Change the inputs, then add your own sentence to the story.'},{time:10,title:'Share & reflect',text:'Read your story aloud. What would you add with one more loop or if?'}]}
];
const clock=minutes=>`${Math.floor(minutes/60)}:${String(minutes%60).padStart(2,'0')}`;
const schema={'@context':'https://schema.org','@type':'LearningResource',name:'One-Hour Coding Activity for Kids',description:'A free, ready-to-run 60-minute coding session plan for kids with three routes: robot puzzles, block coding, and first Python.',url:new URL('/one-hour-coding/',Astro.site).href,learningResourceType:'Lesson plan',educationalLevel:'Beginner',timeRequired:'PT60M',teaches:['Sequences','Loops','Debugging','Variables','If/else decisions'],audience:{'@type':'EducationalAudience',educationalRole:'teacher'},inLanguage:'en',isAccessibleForFree:true,provider:{'@id':new URL('/#organization',Astro.site).href}};
---
<Layout title="Free One-Hour Coding Activity for Kids & Classrooms" description="A free, ready-to-run one-hour coding activity for kids. Three timed routes (robot puzzles, block coding, first Python) for classrooms, clubs, and home. No sign-up." breadcrumbs={[['For grown-ups','/grownups/'],['One-hour coding plan','/one-hour-coding/']]} schema={schema}><div class="wrap"><div class="page-head"><nav class="breadcrumb no-print" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/grownups/">For grown-ups</a><span>/</span><span>One-hour coding plan</span></nav><span class="eyebrow">For classrooms, clubs & kitchen tables</span><h1>One hour.<br/>A lot of “I made that!”<span class="h1-topic">A free one-hour coding activity for kids</span></h1><p>Pick a route, open KidsCode in a browser, and follow the timings. Each plan mixes a warm-up, short hands-on activities, and a moment to share. No accounts, no installs, and no coding experience needed to lead it.</p><div class="actions no-print"><a class="button dark" href="#routes">Choose a route →</a><button class="button ghost" id="print-plan">Print this plan</button></div></div>
<section><span class="eyebrow">Before you start</span><h2>A five-minute setup</h2><div class="grid2" style="margin-top:28px"><div class="card"><h3>Devices</h3><p>A computer, Chromebook, or tablet with an up-to-date browser. Robot missions and Python also work on phones; the block editor likes a bigger screen.</p></div><div class="card"><h3>Internet</h3><p>Pages load from the web. The first Python run downloads the Python engine, so open a lesson and press Run once before the session starts.</p></div><div class="card"><h3>No accounts</h3><p>Nothing to register. Progress saves in each browser, so on shared computers use the reset on the <a href="/explore/#my-progress">Explore page</a> between groups.</p></div><div class="card"><h3>Pairs work well</h3><p>One child drives the mouse or keyboard, the other navigates and checks the plan. Swap every activity so both get a turn.</p></div></div></section>
<section class="section" id="routes"><span class="eyebrow">Three routes · 60 minutes each</span><h2>Choose the route that fits</h2><p>Routes are flexible. Mix them, stretch a favorite activity, or stop early when the room is buzzing.</p><div class="grid3" style="margin-top:28px">{routes.map(route=>{let start=0;return <div class={'card tint-'+route.tint}><span class="pill">{route.who}</span><h3 style="font-size:1.7rem">{route.name}</h3><p>{route.intro}</p><ol style="padding-left:0;list-style:none">{route.steps.map(step=>{const at=clock(start);start+=step.time;return <li style="margin:14px 0"><div class="plan-step"><b>{at}</b><div><strong>{step.href?<a href={step.href}>{step.title}</a>:step.title}</strong> <span class="tiny">· {step.time} min</span><p style="margin:4px 0 0">{step.text}</p></div></div></li>})}</ol><p class="tiny">Total: {route.steps.reduce((total,step)=>total+step.time,0)} minutes</p></div>})}</div></section>
<section class="article" style="padding-bottom:0"><h2>Questions that keep thinking going</h2><ol><li><strong>Predict:</strong> “What do you think will happen when you press Run?”</li><li><strong>Notice:</strong> “What changed? What surprised you?”</li><li><strong>Debug:</strong> “Where did the program stop doing what you expected?”</li><li><strong>Remix:</strong> “Change one number, word, or step. What happens now?”</li></ol><div class="note">Running a session for Computer Science Education Week in December, a coding club, or a rainy afternoon? This plan works any week of the year. KidsCode is independent and free, so there is nothing to register or download.</div><h2>After the hour</h2><p>Children who want more can continue the <a href="/blocks/">block coding trail</a> (20 missions), the <a href="/python/">Python trail</a> (10 lessons), or pick a <a href="/projects/">Python project</a> to remix. New words from the session are in the <a href="/glossary/">coding glossary</a>. For ages, privacy, and accessibility details, read the <a href="/grownups/">parent and teacher guide</a>.</p></section>
<section class="section"><Faq eyebrow="Planning questions" heading="Before you press Run" items={[["Do students need accounts or email addresses?","No. KidsCode has no sign-up or login. Students open the pages and start. Progress is stored in each browser on each device."],["What if we only have 30 minutes?","Use the first half of any route: the warm-up plus the first two activities. Robot missions 1–4 or the first two block missions fit comfortably in half an hour."],["Can children do this at home?","Yes. The same routes work for one child with a grown-up. Take turns being the driver and the navigator."],["Which route should I choose for a mixed group?","Start everyone on the robot missions together, then let confident readers move to the block missions while others continue with robots and pixel art."]]}/></section></div>
<script>document.querySelector('#print-plan')?.addEventListener('click',()=>print());</script>
<style is:global>@media print{.site-header,footer,.no-print,.faq,.learning-connection{display:none!important}.card{break-inside:avoid;border-color:#999}.grid3,.grid2{grid-template-columns:1fr!important}a{text-decoration:none;color:inherit}}</style>
</Layout>
