---
import Layout from '../../layouts/Layout.astro';import PythonEditor from '../../components/PythonEditor.astro';import {lessons} from '../../lib/lessons.mjs';
export function getStaticPaths(){return lessons.map((lesson,index)=>({params:{slug:lesson.slug},props:{lesson,index}}));}
const {lesson:l,index}=Astro.props;const prev=lessons[index-1],next=lessons[index+1];
---
<Layout title={l.topic+' for Kids — '+l.title+' | Kids Code'} description={l.concept}><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/python/">The Python trail</a><span>/</span><span>Lesson {index+1} of {lessons.length}</span></div><span class="eyebrow">{l.topic} · About {l.time} minutes</span><h1>{l.title}</h1></div><div class="lesson-body"><article class="lesson-content"><h2>The big little idea</h2><p>{l.concept}</p><pre><code>{l.example}</code></pre><p>{l.detail}</p><div class="note"><strong>Predict, then try:</strong> read the example from top to bottom. What do you think it will print? Copy it into the editor below to test your prediction.</div></article><aside class="lesson-sidebar"><h3>Your Python trail</h3><ol>{lessons.map(item=><li><a href={'/python/'+item.slug+'/'} aria-current={item.slug===l.slug?'page':undefined}>{item.topic}</a></li>)}</ol><p class="tiny">Take your time. Each little experiment counts.</p></aside></div><div class="challenge"><h2>Your turn, code explorer.</h2><p>{l.challenge}</p><label>Output goal</label><pre>{l.expected}</pre></div><PythonEditor code={l.starter} input={l.input||''} expected={l.expected} lesson={l.slug} storageKey={'lesson-'+l.slug}/><div class="grid2"><details><summary>A little hint, please</summary><p>{l.hint}</p></details><details><summary>Show one possible solution</summary><p>There can be more than one way. Read this version, then try writing it yourself.</p><pre>{l.solution}</pre></details></div><div class="note"><strong>Pack this idea for later:</strong> {l.takeaway}</div><nav class="lesson-nav" aria-label="Lesson navigation">{prev?<a class="button ghost" href={'/python/'+prev.slug+'/'}>← Previous lesson</a>:<a class="button ghost" href="/python/">← All lessons</a>}{next?<a class="button dark" href={'/python/'+next.slug+'/'}>Next: {next.topic} →</a>:<a class="button dark" href="/projects/">You’re ready to make stuff! →</a>}</nav></div></Layout>
