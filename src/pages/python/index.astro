---
import Layout from '../../layouts/Layout.astro';import {lessons} from '../../lib/lessons.mjs';
---
<Layout title="Python for Kids — 10 Interactive Coding Lessons | Kids Code"><div class="wrap"><div class="page-head"><span class="eyebrow">The Python trail · Confident readers & curious tinkerers</span><h1>Little lines.<br/>Real superpowers.</h1><p>Learn Python by making things happen. Every stop has an idea to learn, code to try, and a tiny challenge to make it yours.</p><div class="topic-list"><span>10 hands-on lessons</span><span>5–12 minutes each</span><span>Runs in your browser</span></div></div><div class="lesson-list">{lessons.map((l,i)=><a class="lesson-item" href={'/python/'+l.slug+'/'}><span class="lesson-number">{String(i+1).padStart(2,'0')}</span><div><h3>{l.title}</h3><p>{l.topic} · {l.time} min</p></div><span class="completion" data-completion={'python-'+l.slug}>Try it</span></a>)}</div><section class="section"><div class="cta-band"><div><h2>Already have an idea?</h2><p>Open a blank canvas for your code. Tinker freely.</p></div><a class="button dark" href="/playground/">Open Python playground ↗</a></div></section></div></Layout>
