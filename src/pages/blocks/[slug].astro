---
import Layout from '../../layouts/Layout.astro';import BlockLab from '../../components/BlockLab.astro';import {blockLessons} from '../../lib/blocks/curriculum.mjs';
export function getStaticPaths(){return blockLessons.map(lesson=>({params:{slug:lesson.slug},props:{lesson}}));}
const {lesson:l}=Astro.props;const previous=blockLessons[l.index-1],next=blockLessons[l.index+1];
---
<Layout title={l.topic+' for Kids — Interactive Block Coding | Kids Code'} description={l.idea}><div class="wrap blocks-page"><div class="page-head" style="padding-bottom:15px"><div class="breadcrumb"><a href="/blocks/">Programming foundations</a><span>/</span><span>Mission {l.index+1} of {blockLessons.length}</span></div><span class="eyebrow">{l.group} · {l.time} minutes of curiosity</span></div><div class="block-lesson-head"><div><h1>{l.title}</h1><p>{l.idea}</p></div><aside class="lesson-concept-card"><strong>Picture it like this…</strong><p>{l.example}</p></aside></div><section class="block-task"><h2>Your mission: {l.topic.toLowerCase()}</h2><p>{l.task}</p><div class="goal-chips">{l.tests.map(test=><code>{test.name}: {test.output.join(' → ')}</code>)}</div></section><BlockLab lesson={l}/><div class="block-hints"><details><summary>A little hint, please</summary><p>{l.hint}</p></details><details><summary>How do I use these blocks?</summary><p>Pick a category on the left to see its blocks. Drag a block onto the canvas. Instructions connect in a stack inside “when I press Run”. Rounded value blocks go into sockets. Change a field by selecting the word, number, or dropdown on the block.</p><p>Use the canvas zoom controls or Fit blocks if a stack goes out of view. Undo can bring back an accidental change. Disconnected blocks do not run. Your canvas saves here on this device.</p></details></div><div class="note"><strong>Pack this idea for later:</strong> {l.takeaway} <a href={'/python/'+l.python+'/'}>Explore it in Python →</a></div><nav class="lesson-nav" aria-label="Block lesson navigation">{previous?<a class="button ghost" href={'/blocks/'+previous.slug+'/'}>← Previous mission</a>:<a class="button ghost" href="/blocks/">← All missions</a>}{next?<a class="button dark" href={'/blocks/'+next.slug+'/'}>Next: {next.topic} →</a>:<a class="button dark" href="/blocks/playground/">Your next idea is yours →</a>}</nav><p class="blocks-credit">An independent Kids Code playground, built with <a href="https://blockly.com/">Blockly</a>. No accounts or uploads. Projects stay in this browser unless you download them.</p></div></Layout>
