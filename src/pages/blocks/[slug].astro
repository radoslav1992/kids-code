---
import Layout from '../../layouts/Layout.astro';import BlockLab from '../../components/BlockLab.astro';import {blockLessons} from '../../lib/blocks/curriculum.mjs';import {lessonSchema} from '../../lib/seo.mjs';
export function getStaticPaths(){return blockLessons.map(lesson=>({params:{slug:lesson.slug},props:{lesson}}));}
const {lesson:l}=Astro.props;const previous=blockLessons[l.index-1],next=blockLessons[l.index+1];
const path='/blocks/'+l.slug+'/',title=`${l.topic}${l.topic.length>17?'':' for Kids'} – Block Coding Lesson ${l.index+1}`;
const schema=lessonSchema({site:Astro.site,name:title,path,description:l.idea,topic:l.topic,time:l.time,position:l.index+1,course:'Block Coding for Kids',coursePath:'/blocks/'});
---
<Layout title={title} description={l.idea} breadcrumbs={[['Block coding for kids','/blocks/'],[`Mission ${l.index+1}: ${l.topic}`,path]]} schema={schema}><div class="wrap blocks-page"><div class="page-head" style="padding-bottom:15px"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blocks/">Block coding for kids</a><span>/</span><span>Mission {l.index+1} of {blockLessons.length}</span></nav><span class="eyebrow">{l.group} · {l.time} minutes of curiosity</span></div><div class="block-lesson-head"><div><h1>{l.title}<span class="h1-topic">{l.topic} with code blocks</span></h1><p>{l.idea}</p></div><aside class="lesson-concept-card"><strong>Picture it like this…</strong><p>{l.example}</p></aside></div><section class="block-task"><h2>Your mission: {l.topic.toLowerCase()}</h2><p>{l.task}</p><div class="goal-chips">{l.tests.map(test=><code>{test.name}: {test.output.join(' → ')}</code>)}</div></section><BlockLab lesson={l}/><div class="block-hints"><details><summary>A little hint, please</summary><p>{l.hint}</p></details><details><summary>How do I use these blocks?</summary><p>Pick a category on the left to see its blocks. Drag a block onto the canvas. Instructions connect in a stack inside “when I press Run”. Rounded value blocks go into sockets. Change a field by selecting the word, number, or dropdown on the block.</p><p>Use the canvas zoom controls or Fit blocks if a stack goes out of view. Undo can bring back an accidental change. Disconnected blocks do not run. Your canvas saves here on this device.</p></details></div><div class="note"><strong>Pack this idea for later:</strong> {l.takeaway} <a href={'/python/'+l.python+'/'}>Explore it in Python →</a></div><nav class="lesson-nav" aria-label="Block lesson navigation">{previous?<a class="button ghost" href={'/blocks/'+previous.slug+'/'}>← Previous mission</a>:<a class="button ghost" href="/blocks/">← All missions</a>}{next?<a class="button dark" href={'/blocks/'+next.slug+'/'}>Next: {next.topic} →</a>:<a class="button dark" href="/blocks/playground/">Your next idea is yours →</a>}</nav><p class="blocks-credit">An independent Kids Code playground, built with <a href="https://blockly.com/">Blockly</a>. No accounts or uploads. Projects stay in this browser unless you download them.</p></div></Layout>
