import Layout from '../layouts/Layout.astro';import Bot from '../components/Bot.astro';import {lessons} from '../lib/lessons.mjs';
---
<Layout title="Coding Activities & Learning Paths for Kids | Kids Code"><div class="wrap"><div class="page-head"><span class="eyebrow">Your adventure map</span><h1>Where will your<br/>curiosity take you?</h1><p>There’s no wrong door. Start somewhere fun, follow an idea, and see what you can make.</p></div><div class="grid2"><a class="card card-link tint-blue" href="/blocks/"><span class="pill">NEW · THE FOUNDATIONS TRAIL</span><h3>Learn with real blocks</h3><p>Snap together variables, if/else, loops, lists, records, and functions. Watch your program run, then test your ideas.</p><div class="card-footer">20 missions + free playground <span>→</span></div></a><a class="card card-link tint-green" href="/adventures/"><span class="pill">01 · START HERE</span><h3>Code adventures</h3><p>Guide Bit to the star with tap-to-add commands. Discover sequences, loops, and how to fix a bug.</p><div class="card-footer">8 robot missions <span>→</span></div></a><a class="card card-link tint-peach" href="/studio/"><span class="pill peach">02 · GET CREATIVE</span><h3>Pixel studio</h3><p>Discover coordinates and patterns while you make a tiny masterpiece. Download it and keep it.</p><div class="card-footer">An open canvas <span>→</span></div></a><a class="card card-link tint-yellow" href="/python/"><span class="pill yellow">03 · LEVEL UP</span><h3>The Python trail</h3><p>From your first hello to your own functions. Write real code and watch your ideas come alive.</p><div class="card-footer">10 guided lessons <span>→</span></div></a></div><section class="section" id="my-progress"><div class="progress-banner"><Bot size={85}/><div><h2>Your discoveries</h2><p>Little victories, saved in this browser.</p></div><span class="progress-number" data-total>0</span><button class="button small white" data-reset-progress>Reset progress</button></div><div class="grid2"><div class="card"><h3>The maker’s collection</h3><p>Earn a discovery by completing a robot mission, finishing a block-coding or Python challenge, creating pixel art, or completing the detective quiz.</p><div class="topic-list"><span>▦ Block inventor</span><span>🤖 Robot explorer</span><span>🎨 Pixel maker</span><span>⌨ Python tinkerer</span><span>🔎 Bug detective</span></div><p class="tiny">No streaks to keep. No race to finish. Come back whenever curiosity calls. Progress stays on this device; private browsing may not keep it.</p></div><div class="card"><h3>Keep exploring</h3><p>Try a new kind of challenge, or revisit an old one with a different idea.</p><div class="actions"><a class="button small" href="/debug-detective/">Bug detective →</a><a class="button small ghost" href="/projects/">Project starters →</a></div><a href="/glossary/">What does that coding word mean?</a></div></div></section></div><dialog id="reset-dialog"><h2>Start a fresh collection?</h2><p>This clears completed activities on this device. Your Python draft and pixel art stay as they are.</p><div class="actions"><button class="button" data-confirm-reset>Reset progress</button><form method="dialog"><button class="button ghost">Keep my discoveries</button></form></div></dialog></Layout>
