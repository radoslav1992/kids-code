import Layout from '../layouts/Layout.astro';
---
<Layout title="Coding Quiz for Kids — Become a Bug Detective | Kids Code"><div class="wrap"><div class="page-head"><span class="eyebrow">The bug detective club</span><h1>Every bug<br/>leaves a clue.</h1><p>Predict the output, spot a little mistake, and discover how programmers think. No timer. No pressure. Just eight chances for an “aha!”</p></div><div class="panel" style="max-width:780px;margin-bottom:60px"><div class="quiz-progress" aria-hidden="true"><span id="quiz-bar"></span></div><p class="eyebrow" id="quiz-position"></p><h2 id="quiz-question" tabindex="-1"></h2><pre id="quiz-code" class="note" hidden></pre><div id="quiz-options" class="quiz-options"></div><div class="feedback" id="quiz-feedback" role="status">Pick the answer you think fits.</div><div class="actions"><button class="button dark" id="quiz-next" hidden>Next clue →</button><button class="button" id="quiz-restart" hidden>Play again ↻</button><a href="/python/" id="quiz-learn" hidden>Explore the Python trail →</a></div><noscript><p>Turn on JavaScript to try the detective quiz.</p></noscript></div></div><script>import '../scripts/quiz';</script></Layout>
